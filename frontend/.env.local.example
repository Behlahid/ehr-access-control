# Contract Address (Default is local hardhat deployed address)
NEXT_PUBLIC_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# IPFS Provider ('local', 'pinata', 'mock')
NEXT_PUBLIC_IPFS_PROVIDER=local
NEXT_PUBLIC_IPFS_API_URL=http://127.0.0.1:5001
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs/

# Optional: Pinata JWT Token for production IPFS pinning
NEXT_PUBLIC_PINATA_JWT=
