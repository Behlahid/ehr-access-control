# Ethereum Sepolia Testnet RPC URL (from Alchemy, Infura, or QuickNode)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# Deployer Private Key (Exported from MetaMask test wallet - DO NOT use mainnet private keys)
PRIVATE_KEY=0x0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Optional: Etherscan API Key for contract verification
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# Optional: Enable or disable Gas Reporter in terminal ('true' or 'false')
REPORT_GAS=true

# Optional: CoinMarketCap API Key for live USD gas pricing in gas reporter
COINMARKETCAP_API_KEY=
